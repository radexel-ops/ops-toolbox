# ===== Server Configuration =====
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Project root path (for Claude Code working directory)
VIBEOPS_PROJECT_ROOT=/home/vibeops/vibeops/rpa/RDXL_OPS

# ===== Database =====
DATABASE_PATH=./data/vibeops.db

# ===== Security =====
# IMPORTANT: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, SECRET_KEY must be at least 32 characters!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# ===== Douzone (WEHAGO) =====
DOUZONE_USERNAME=your_douzone_username
DOUZONE_PASSWORD=your_douzone_password
DOUZONE_COMPANY_CODE=your_company_code

# ===== Slack =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_CHANNEL=#vibeops-alerts

# ===== AI API Keys (ai_list.md 참조) =====
# Main AI: Google Gemini
GOOGLE_API_KEY=your_google_api_key
# https://aistudio.google.com/apikey

# Sub AI: OpenAI GPT
OPENAI_API_KEY=your_openai_api_key
# https://platform.openai.com/api-keys

# Sub AI: Anthropic (지원 예정)
ANTHROPIC_API_KEY=your_anthropic_api_key
# https://console.anthropic.com/

# ===== News Scraping =====
NEWS_KEYWORDS=AI,자동화,RPA,인공지능
NEWS_SOURCES=naver,google

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=./logs/vibeops.log

# ===== Tmux =====
TMUX_SESSION_NAME=vibeops

# ===== Claude Code CLI =====
# Claude Code uses the Anthropic Max plan ($20/month)
# Login with: claude auth login
# Check status: claude --version
CLAUDE_CODE_TIMEOUT=300
