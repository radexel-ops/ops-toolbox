# AI Infinite Chat - 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 API 키를 입력하세요

# ============================================
# AI API Keys (최소 하나 이상 필수)
# ============================================

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google AI (Gemini) API Key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic (Claude) API Key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here



# ============================================
# 서버 설정 (선택사항 - 기본값 사용 가능)
# ============================================

# 호스트 (Docker에서는 0.0.0.0 권장)
# HOST=0.0.0.0

# 포트
# PORT=8000

# 디버그 모드 (프로덕션에서는 false)
# DEBUG=false
