# ===================================================
# RDXL_RPA 팀 공용 설정
#
# 이 파일은 Git에 커밋됩니다 (민감한 정보 포함 금지!)
# API 키, 비밀번호 등은 .env.local 에 저장하세요
# ===================================================


# =============================================================================
# Slack 채널 ID
#
# Slack 채널 ID 확인 방법:
#   1. Slack 데스크톱 앱에서 채널 우클릭 → "채널 세부정보 보기"
#   2. 맨 아래 "채널 ID" 복사 (예: C08V9CA0UPM)
# =============================================================================

# 기본 알림 채널 (자동화 테스트용)
SLACK_CHANNEL=C08V9CA0UPM
SLACK_CHANNEL_DEFAULT=C08V9CA0UPM

# 뉴스 스크래핑 결과 전송 채널
SLACK_CHANNEL_NEWS=C07H9MB8JQ4

# PubMed 논문 알림 채널
SLACK_CHANNEL_PUBMED=C07HJ4RQGAC

# 근태/부재 알림 채널 (매일 아침 부재자 알림)
SLACK_CHANNEL_ABSENCE=C06PZGY59S6
SLACK_CHANNEL_ATTENDANCE=C06PZGY59S6

# 시스템 상태 모니터링 채널 (heartbeat 전송)
SLACK_CHANNEL_HEARTBEAT=C08V9CA0UPM


# =============================================================================
# Google Calendar / Sheets 설정
#
# 캘린더/시트 ID 확인 방법:
#   - Calendar: Google Calendar → 설정 → 캘린더 통합 → 캘린더 ID
#   - Sheets: 스프레드시트 URL에서 /d/ 뒤의 긴 문자열
# =============================================================================

# OAuth 토큰 저장 경로 (첫 실행 시 브라우저 인증 후 자동 생성)
GOOGLE_TOKEN_PATH=token.json

# 부재/휴가 일정 캘린더 ID (RDXL_부재/외부일정)
GCAL_ABSENCE_CALENDAR_ID=c_a691b5b6d11b9c1717fdc1a4ef2bf106b9a5cd76c90605337bd5dca7546ce3ad@group.calendar.google.com
GOOGLE_CALENDAR_ID=c_a691b5b6d11b9c1717fdc1a4ef2bf106b9a5cd76c90605337bd5dca7546ce3ad@group.calendar.google.com

# 직원 정보 스프레드시트 (닉네임 매핑용)
GOOGLE_SHEETS_NICKNAME_SPREADSHEET_ID=1bQA0tYIa-jU3DG_t29KWjvYDxQCN6EAj70adGD315zo
GOOGLE_SHEETS_NICKNAME_RANGE="'직원 정보'!A:Z"


# =============================================================================
# 스크립트 동작 옵션
# =============================================================================

# WEHAGO 휴가 데이터 수집 기간 (현재 월 기준 몇 개월 전까지)
WEHAGO_MONTHS=6

# 시간대 설정
TIMEZONE=Asia/Seoul

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# OpenAI 기본 모델
OPENAI_DEFAULT_MODEL=o4-mini

# 제외할 폴더 키워드 (콤마 구분)
APP_EXCLUDE_KEYWORDS=X_,logs
