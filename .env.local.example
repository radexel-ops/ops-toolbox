# ===================================================
# RDXL_RPA 개인/비밀 환경변수
#
# 사용법:
#   1. 이 파일을 복사하여 .env.local 로 저장
#      $ cp .env.local.example .env.local
#   2. 아래 값들을 실제 값으로 변경
#   3. .env.local 파일은 Git에 업로드되지 않음 (안전)
#
# ⚠️  이 파일에 실제 값을 입력하지 마세요!
#     반드시 .env.local 파일을 만들어서 거기에 입력하세요.
# ===================================================


# =============================================================================
# WEHAGO 로그인 정보 (본인 계정)
#
# WEHAGO 휴가 데이터 수집에 사용됩니다.
# 본인의 WEHAGO 계정 정보를 입력하세요.
# =============================================================================

WEHAGO_ID=여기에_본인_위하고_아이디
WEHAGO_PW=여기에_본인_위하고_비밀번호


# =============================================================================
# Slack Bot Token (팀 공용)
#
# Slack 봇 토큰 확인 방법:
#   1. https://api.slack.com/apps 접속
#   2. 앱 선택 → OAuth & Permissions → Bot User OAuth Token
#   3. xoxb-로 시작하는 토큰 복사
#
# ⚠️  팀장에게 문의하여 토큰을 받으세요
# =============================================================================

SLACK_TOKEN=xoxb-팀장에게_문의


# =============================================================================
# Google OAuth 2.0 클라이언트 (팀 공용)
#
# Google Calendar/Sheets API 접근에 필요합니다.
#
# 클라이언트 ID/Secret 확인 방법:
#   1. https://console.cloud.google.com 접속
#   2. APIs & Services → Credentials
#   3. OAuth 2.0 Client IDs 에서 Desktop App 선택
#   4. Client ID와 Client Secret 복사
#
# ⚠️  팀장에게 문의하여 값을 받으세요
# =============================================================================

# Google OAuth Client ID (xxx.apps.googleusercontent.com 형식)
GOOGLE_CLIENT_ID=팀장에게_문의.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=팀장에게_문의.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=팀장에게_문의
GOOGLE_OAUTH_CLIENT_SECRET=팀장에게_문의


# =============================================================================
# AI API 키 (팀 공용)
#
# 회계 분류, QMS R&R 등 AI 기능에 사용됩니다.
#
# ⚠️  팀장에게 문의하여 키를 받으세요
# =============================================================================

# OpenAI API Key (sk-proj-로 시작)
# 확인: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-팀장에게_문의

# Google Gemini API Key (AIza로 시작)
# 확인: https://aistudio.google.com/app/apikey
GENAI_API_KEY=팀장에게_문의

# Google AI API Key (debate AIs 프로젝트용, AIza로 시작)
# text_debate, AI Infinite Chat 등에서 사용
GOOGLE_API_KEY=팀장에게_문의
