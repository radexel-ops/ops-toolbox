# ===================================================
# RDXL_RPA 개인/비밀 환경변수
#
# 사용법:
#   1. 이 파일을 복사하여 .env.local 로 저장
#   2. 아래 값들을 실제 값으로 변경
#   3. .env.local 파일은 Git에 업로드되지 않음
#
# 팀 공용 API 키는 팀장에게 문의하세요
# ===================================================

# ===== WEHAGO 로그인 (본인 계정) =====
WEHAGO_ID=여기에_본인_위하고_아이디
WEHAGO_PW=여기에_본인_위하고_비밀번호

# ===== 팀 공용 API 키 (팀장에게 문의) =====
SLACK_TOKEN=xoxb-팀장에게_문의
GOOGLE_CLIENT_ID=팀장에게_문의.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=팀장에게_문의
GOOGLE_OAUTH_CLIENT_ID=팀장에게_문의.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=팀장에게_문의
OPENAI_API_KEY=sk-팀장에게_문의
GENAI_API_KEY=팀장에게_문의

# ===== 선택사항 =====
# WEHAGO_MONTHS=6
